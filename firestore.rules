rules_version = '2';

// Reglas de Firestore para Kizuna. Cópialas en
// Firebase → Firestore Database → Reglas → Publicar. Ver ADMIN.md.
//
// - Cualquiera puede leer los artículos publicados y los planes visibles.
// - Solo quien tenga un documento en admins/{su UID} puede escribir.
// - La colección admins no se puede editar desde el sitio: se maneja
//   a mano en la consola de Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validPost(d) {
      return d.keys().hasAll(['title', 'date', 'body', 'published'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.body is string && d.body.size() <= 200000
        && d.published is bool;
    }

    function validPlan(d) {
      return d.keys().hasAll(['name', 'visible', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.visible is bool
        && d.order is number
        && (!('price' in d) || d.price == null || (d.price is number && d.price >= 0));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /posts/{slug} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && slug.matches('^[a-z0-9-]{1,80}$')
        && validPost(request.resource.data);
      allow delete: if isAdmin();
    }

    match /plans/{id} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update: if isAdmin() && validPlan(request.resource.data);
      allow delete: if isAdmin();
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
