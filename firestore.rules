rules_version = '2';

// Reglas de Firestore para Kizuna. Cópialas en
// Firebase → Firestore Database → Reglas → Publicar. Ver ADMIN.md.
//
// - Cualquiera puede leer los artículos publicados y los planes visibles.
// - Solo quien tenga un documento en admins/{su UID} puede escribir en ellos.
// - classes, slots, closures y bookings (reservas) solo las ve el panel.
// - La colección admins no se puede editar desde el sitio: se maneja
//   a mano en la consola de Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function shortText(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function validPost(d) {
      return d.keys().hasAll(['title', 'date', 'body', 'published'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.body is string && d.body.size() <= 200000
        && d.published is bool
        && shortText(d, 'ex', 300)
        && shortText(d, 'cat', 30)
        && (!('cats' in d) || (d.cats is list && d.cats.size() <= 10))
        && shortText(d, 'letter', 3);
    }

    function validPlan(d) {
      return d.keys().hasAll(['name', 'visible', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.visible is bool
        && d.order is number
        && shortText(d, 'for', 140)
        && (!('feats' in d) || (d.feats is list && d.feats.size() <= 20))
        && (!('price' in d) || d.price == null || (d.price is number && d.price >= 0));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /posts/{slug} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && slug.matches('^[a-z0-9-]{1,80}$')
        && validPost(request.resource.data);
      allow delete: if isAdmin();
    }

    // Temas del blog: solo el panel los lee y escribe
    match /topics/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && id.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin();
    }

    // Fotos de los artículos (data URL ya reducida desde el panel). Las ve cualquiera.
    match /images/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && id.matches('^[A-Za-z0-9_-]{8,40}$')
        && request.resource.data.keys().hasOnly(['data', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000;
      allow delete: if isAdmin();
    }

    match /plans/{id} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update: if isAdmin() && validPlan(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- Reservas propias (ver RESERVAS.md) ----
    // Las crea y cambia solo el servidor (api/*.js, con la cuenta de servicio, que
    // se salta estas reglas). Desde el sitio nadie puede leer ni escribir reservas:
    // contienen teléfonos y correos. El panel las lee y puede cancelarlas.
    function validClass(d) {
      return d.keys().hasAll(['label', 'active', 'order'])
        && d.label is string && d.label.size() > 0 && d.label.size() <= 60
        && d.active is bool
        && d.order is number
        && shortText(d, 'tone', 12)
        && shortText(d, 'clubTone', 12)
        && shortText(d, 'discipline', 30)
        && shortText(d, 'type', 20)
        && shortText(d, 'club', 30)
        && (!('design' in d) || (d.design is number && d.design >= 0 && d.design <= 4))
        && shortText(d, 'page', 60)
        && (!('duration' in d) || (d.duration is number && d.duration >= 10 && d.duration <= 300))
        && (!('capacity' in d) || (d.capacity is number && d.capacity >= 1 && d.capacity <= 200));
    }

    function validSlot(d) {
      return d.keys().hasAll(['classId', 'day', 'start', 'active'])
        && d.classId is string && d.classId.size() <= 40
        && d.day in ['lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado', 'domingo']
        && d.start is string && d.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.active is bool
        && shortText(d, 'note', 60)
        && (!('date' in d) || (d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('duration' in d) || (d.duration is number && d.duration >= 10 && d.duration <= 300))
        && (!('capacity' in d) || (d.capacity is number && d.capacity >= 1 && d.capacity <= 200));
    }

    function validClosure(d) {
      return d.keys().hasAll(['date'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && shortText(d, 'reason', 80)
        && shortText(d, 'slotId', 40);
    }

    match /classes/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && id.matches('^[a-z0-9-]{1,40}$') && validClass(request.resource.data);
      allow delete: if isAdmin();
    }

    match /slots/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validSlot(request.resource.data);
      allow delete: if isAdmin();
    }

    match /closures/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validClosure(request.resource.data);
      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
